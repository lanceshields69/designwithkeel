# Copy to .env.local and fill in as each service is actually wired up.
# Nothing here is required yet — see src/env.ts.

# --- Server-only ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
# FIRECRAWL_API_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# JOB_SERVICE_URL=
# JOB_SERVICE_TOKEN=
# SENTRY_DSN=

# --- Public (inlined into the client bundle at build time — no secrets) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Teaser waitlist (Formspree, temporary — see docs/decisions/0004) ---
